# Variables del formulario de contacto (endpoint POST /api/contact, vía Resend).
#
# En local: copiá este archivo a .env y completá los valores. Los scripts
# `start` y `serve:ssr:client` lo cargan solos (node --env-file-if-exists);
# si el archivo no existe, arrancan igual y los endpoints responden 503.
# En Vercel: cargalas en Project Settings → Environment Variables, para los
# entornos Production y Preview. Sin ellas el endpoint responde 503
# EMAIL_NOT_CONFIGURED y el resto del sitio sigue funcionando.

# API key de Resend (https://resend.com → API Keys → Create). Empieza con
# "re_", mide unos 36 caracteres y no lleva espacios. OJO: no es la contraseña
# de aplicación de Gmail (16 caracteres en 4 grupos) — ésa acá no sirve.
RESEND_API_KEY=

# Casilla que recibe los mensajes del formulario.
CONTACT_TO_EMAIL=

# Remitente. Debe pertenecer a un dominio verificado en Resend.
# Si se omite, usa el remitente de prueba de Resend (onboarding@resend.dev).
CONTACT_FROM_EMAIL=

# ───────────────────────────────────────────────────────────────────────────
# Panel de contenido (/admin)
#
# Sin estas dos variables el panel responde 503 y no se puede entrar: no hay
# clave por defecto ni modo abierto. El sitio público funciona igual.
# ───────────────────────────────────────────────────────────────────────────

# Hash de la clave de acceso. Se genera con:  bun run admin:hash "<clave>"
# La clave en claro no se guarda en ningún lado.
ADMIN_PASSWORD_HASH=

# Secreto con el que se firman las sesiones del panel. Una cadena larga y al
# azar, distinta por entorno:  openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Dónde se guarda el contenido editado, en local. Por omisión,
# .data/content.json junto al proyecto. Se ignora si está configurado Redis.
CONTENT_FILE=

# Redis (Upstash) para el contenido. Obligatorio en Vercel, donde el disco es
# de sólo lectura: sin esto el sitio se ve pero el panel no puede publicar.
# La integración de Upstash del Marketplace de Vercel las carga sola con estos
# nombres; también se aceptan UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
# En local, si se dejan vacías, se usa el archivo.
KV_REST_API_URL=
KV_REST_API_TOKEN=
